---
import Button from '../components/Button.astro';

---

<section class="hero" id="home">
	<div class="container">
		<div class="hero__content">
            <h1 class="hero__title">Hi! My name is <span>Yosephine Manihuruk</span></h1>
            <Button text="View my work" href="#work" />
        </div>
	</div>
</section>


<style>
    .hero {
        display: flex;
        text-align: center;
        align-items: center;
        height: 100vh;
        justify-content: center;
        background: url('../assets/background.png');
        background-position: left;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .hero__content {
        max-width: 800px;
        margin-inline: auto;
    }

    h1 {
        font-size: 2.5rem;
        line-height: 1.3; 
        margin-bottom: 1rem;
    }

    span {
        color: var(--secondary-clr-400);
    }

    .hero__title {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .hero__title span {
        color: var(--primary-clr-400);
    }

    @media (min-width: 768px) {
        h1 {
            font-size: 3.5rem;
        }
    }

</style>